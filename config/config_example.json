{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "CLIENT UUID",
            "flow": "xtls-rprx-vision",
            "email": "CUSTOM USER NAME"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "apple.com:443",
          "xver": 0,
          "serverNames": [
            "apple.com"
          ],
          "privateKey": "PRIVATE KEY",
          "shortIds": [
            "SHORT ID"
          ]
        }
      },
      "sniffing": {
      	"enabled": true,
      	"destOverride": [
      		"http",
      		"tls"
      	]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
