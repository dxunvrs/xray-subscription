{
  "log": {
    "loglevel": "warning"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsUserUplink": true,
      "statsUserDownlink": true
    }
  },
  "api": {
    "tag": "api",
    "services" : [
      "HandlerService",
      "StatsService",
      "LoggerService"
    ]
  },
  "inbounds": [
    {
      "tag": "dock-api",
      "listen": "/run/xray/api.sock",
      "port": 0,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "/run/xray/api.sock",
        "port": 23456,
        "network": "unix"
      }
    },
    {
      "tag": "vless-inbound",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "apple.com:443",
          "xver": 0,
          "serverNames": [
            "apple.com"
          ],
          "privateKey": "PRIVATE KEY",
          "shortIds": [
            "SHORT ID"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["dock-api"],
        "outboundTag": "api"
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
