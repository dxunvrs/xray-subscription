{
  "log": {
    "loglevel": "warning"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsUserUplink": true,
      "statUserDownlink": true
    }
  },
  "api": {
    "tag": "api",
    "services" : [
      "HandlerService",
      "StatsService",
      "LoggerService"
    ]
  },
  "inbounds": [
    {
      "tag": "dock-api",
      "port": 10085,
      "protocol": "dokodemo-door"
    },
    {
      "tag": "vless-inbound",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "CLIENT UUID",
            "flow": "xtls-rprx-vision",
            "email": "CUSTOM USER NAME"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "apple.com:443",
          "xver": 0,
          "serverNames": [
            "apple.com"
          ],
          "privateKey": "PRIVATE KEY",
          "shortIds": [
            "SHORT ID"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["dock-api"],
        "outboundTag": "api"
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
